# FixMyCity backend — environment variables
# Copy to backend/.env for local dev (never commit .env). On your host
# (Render / HF Spaces) set these in the dashboard env/secrets instead.

# --- Database ---
# MongoDB connection string (Atlas or local). Falls back to a local mongod if unset.
MONGO_URI=mongodb://127.0.0.1:27017/FixMyCity

# --- Auth ---
# JWT signing secret. MUST set a strong random value in production — an unset
# secret falls back to an insecure dev value and warns at boot.
JWT_SECRET=change-me-to-a-long-random-string

# JWT expiry (optional; default 7d).
JWT_EXPIRES_IN=7d

# --- Super Admin ---
# Seed credentials for the root superadmin account. Used only when the Admin
# collection has no superadmin (first boot). Email MUST match your Brevo sender
# (receives OTP). Change the password immediately after first login.
SUPERADMIN_EMAIL=debmalyobarman2003@gmail.com
SUPERADMIN_PASSWORD=SuperAdmin@2024

# --- CORS ---
# Comma-separated list of allowed browser origins. The Vite dev server runs on
# port 5173 by default; add your Vercel/production URL(s) as well.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- ML image validation ---
# Mode 1 (default): separate ML service over HTTP. Set ML_SERVICE_URL to the
# deployed ml-service URL. UNSET → validation skipped, complaints save unchecked.
ML_SERVICE_URL=http://localhost:7860

# Shared secret sent as `X-ML-KEY` to the ML service. Must MATCH the ML service's
# ML_KEY. Leave blank only if the ML service also has no ML_KEY (local dev).
ML_KEY=

# Mode 2: run the ML pipeline IN THIS PROCESS (no separate service). Set for a
# single co-run deploy (e.g. one Render free service — fits 750hr/mo + 512MB).
# When true, ML_SERVICE_URL/ML_KEY are ignored. Pair with DISABLE_CLIP=true.
# ML_INLINE=true

# Skip the CLIP model (~150MB) to keep RAM under 512MB. "Others" then uses a
# keyword fallback; civic 4-class + NSFW moderation stay active. Recommended
# with ML_INLINE on memory-tight free tiers.
# DISABLE_CLIP=true

# Abort an HTTP infer call after this many ms (Mode 1 only; default 60000).
# Shared-CPU tfjs inference is slow (~25-60s/image) — keep this generous.
ML_TIMEOUT_MS=60000

# --- Brevo (Sendinblue) — for Super Admin OTP emails ---
# If unset, OTP is only logged to the console (stub/dev mode). Safe to omit in
# local dev. In production MUST be set so superadmin login works end-to-end.
#
# Delivery auto-routes on the BREVO_API_KEY prefix:
#   • "xkeysib-…" (v3 API key)  -> Brevo HTTP API (POST api.brevo.com, port 443).
#       Use this in production. REQUIRED on hosts that block outbound SMTP —
#       Render's free tier blocks ports 25/465/587, so the SMTP path hangs there.
#       BREVO_SMTP_USER is ignored on this path.
#   • "xsmtpsib-…" (SMTP password) -> nodemailer SMTP (needs BREVO_SMTP_USER too).
#       Works locally where port 587 is reachable; blocked on Render free tier.
# The sender (BREVO_FROM_EMAIL) must be a VERIFIED sender in Brevo or the API 4xx's.
# All paths have a hard send timeout (override OTP_SEND_TIMEOUT_MS, default 9000ms)
# so a blocked port / slow API can never hang the login request.
BREVO_API_KEY=xkeysib-your-brevo-v3-api-key-here
BREVO_SMTP_USER=your-brevo-login@example.com
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_FROM_EMAIL=no-reply@fixmycity.in
BREVO_FROM_NAME=FixMyCity
# OTP_SEND_TIMEOUT_MS=9000

# --- Server ---
PORT=5000

# --- Dev/test only ---
# Bypass rate limiters (e2e tests). NEVER set in production.
# DISABLE_RATE_LIMIT=true
