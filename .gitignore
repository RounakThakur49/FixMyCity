.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
ml-service/.env

# Python venv / cache
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# CLIP model download cache (@xenova/transformers + build_others_exemplars.py)
