ml-service/.cache/

# Training dataset (large; bring your own per README)
backend/my_dataset/
backend/my_dataset_excess/
backend/my_dataset_rejected/

# ML model artifacts (large; regenerated by train_civic_model.py)
backend/civic_model.keras
