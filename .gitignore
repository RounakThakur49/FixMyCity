# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
build/

# env (secrets — never commit). Block every .env variant anywhere in the tree,
# but ALWAYS keep the placeholder-only *.env.example files tracked so setup docs
# work. (GitGuardian July 2026: the actual leak was a hardcoded superadmin
# default in backend/db/seed.js — source, not a file — and is fixed there;
# these rules stop any real .env from ever being committed alongside it.)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
backend/.env
frontend/.env
ml-service/.env

# Python venv / cache
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# CLIP model download cache (@xenova/transformers + build_others_exemplars.py)
backend/.cache/
ml-service/.cache/

# Training dataset (large; bring your own per README)
backend/my_dataset/
backend/my_dataset_excess/
backend/my_dataset_rejected/

# ML model artifacts (large; regenerated by train_civic_model.py)
backend/civic_model.keras
backend/civic_model_tfjs/
backend/civic_thresholds.json
backend/civic_saved_model/
backend/audit_report.csv

# Legacy artifacts (older pothole-only model)
backend/pothole_model_tfjs/
backend/pothole_model.h5

# Playwright MCP scratch
.playwright-mcp/

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary Datasets and Testing
backend/temp_*/
backend/my_dataset_quarantine/
backend/temp_kaggle/
test-results/
playwright-report/
backend/test_db.js

# Dataset backups / raw dumps (large, local-only — never commit)
backend/*_backup*/
backend/drainage_backup_flooding/
backend/others_backup_garbage/
backend/my_dataset_nested_raw/
backend/my_dataset_excess/
backend/my_dataset_rejected/

# Archives / bundles (regenerate locally)
*.zip
backend/*.zip
civic_artifacts.zip

# Logs
*.log
backend/*.log
clean_report.csv
dataset_validation_report.json

# Keras training checkpoints (large; regenerated by training)
backend/*.keras
backend/civic_model_stage1_best.keras
backend/civic_model_stage2_best.keras

# Pre-refactor monolith backup (rollback ref only — not for repo)
backend/server.monolith.bak.js

# One-time migration/debug scripts with hardcoded credentials
backend/smart_migrate.js
backend/migrate_from_fork.js
backend/inspect_second_source.js
frontend/src/components/layout/test_users.js
frontend/test_details.js

# Sample project folders (imported for reference — not part of FixMyCity)
NodeProjectSample/
ReactProjectSample/

# Local credentials reference (not for repo)
CREDENTIALS.local.md

# Claude Code memory (session-local)
.claude/

# Downloads / temp artifacts
backend/_downloads/
