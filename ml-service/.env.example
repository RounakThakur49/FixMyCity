# FixMyCity ML service — environment variables
# Copy to .env for local dev (never commit .env). On Hugging Face Spaces set
# these as repository "Secrets"/"Variables" in the Space settings instead.

# Port the service listens on. Hugging Face Spaces REQUIRES 7860.
PORT=7860

# Shared secret. When set, POST /api/infer requires header `X-ML-KEY: <ML_KEY>`.
# Set the SAME value here and as ML_KEY on the backend so only the backend can
# reach this inference box. Leave blank for local dev (endpoint open).
ML_KEY=
