# FixMyCity frontend — environment variables
# Copy to frontend/.env for local dev. On Vercel, set these in the project's
# Environment Variables settings instead.
#
# ⚠️ Create React App bakes REACT_APP_* into the JS bundle at BUILD time. After
# changing this on Vercel you MUST trigger a redeploy — a plain env edit does
# nothing until the next build. (There is also a runtime override: the in-app
# "change API URL" prompt writes localStorage['fixmycity-api-url'], which beats
# this value without a rebuild.)

# Base URL of the backend API. Point at your deployed backend in production,
# e.g. https://fixmycity-backend.onrender.com
REACT_APP_API_URL=http://localhost:5000

# Google Maps JS API key (optional). Without it the map falls back to
# geolocation-only mode.
# REACT_APP_GOOGLE_MAPS_API_KEY=

# --- CRA dev-server speed (optional; local only) ---
DISABLE_ESLINT_PLUGIN=true
GENERATE_SOURCEMAP=false
BROWSER=none
TSC_COMPILE_ON_ERROR=true
